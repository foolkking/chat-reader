{
  "name": "chat-reader",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "nanoid@>=3.0.0 <3.3.17": "3.3.17",
      "postcss@<8.5.26": "8.5.26",
      "browserslist@<4.28.8": "4.28.8",
      "dompurify@<3.4.14": "3.4.14"
    }
  },
  "scripts": {
    "dev:web": "corepack pnpm --filter web dev -H 0.0.0.0 -p 3000",
    "dev:api": "cd apps/api && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "dev:worker": "cd apps/api && python -m app.workers.import_worker",
    "lint": "corepack pnpm --filter web lint",
    "typecheck": "corepack pnpm --filter web typecheck",
    "test:api": "cd apps/api && pytest",
    "ci:changed-area": "node scripts/ci/changed-area-selector.mjs",
    "test:attachment-range": "node --test scripts/performance/measure-attachment-ranges.test.mjs",
    "test:ci-tools": "node --test scripts/ci/changed-area-selector.test.mjs",
    "verify:chromium": "node scripts/verify-chromium.mjs",
    "check": "corepack pnpm typecheck && corepack pnpm test:api"
  }
}
