APP_NAME=chat-reader
APP_ENV=development

POSTGRES_DB=chat_reader
POSTGRES_USER=chat_reader
POSTGRES_PASSWORD=chat_reader
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://chat_reader:chat_reader@localhost:5432/chat_reader

API_PORT=8000
WEB_PORT=3000

# Used only by the Next.js server-side rewrite. Browser requests use /api/*.
API_INTERNAL_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PUBLIC_WEB_BASE_URL=http://localhost:3000

MAX_IMPORT_FILE_SIZE_MB=50
IMPORT_STORAGE_DIR=storage/imports
EXPORT_STORAGE_DIR=storage/exports
OFFLINE_STORAGE_DIR=storage/offline
ASSET_STORAGE_DIR=storage/assets
ASSET_STORAGE_BACKEND=local
# S3-compatible deployments set ASSET_STORAGE_BACKEND=s3 and configure these values.
ASSET_S3_BUCKET=
ASSET_S3_ENDPOINT_URL=
ASSET_S3_REGION=
ASSET_S3_PREFIX=attachments
ATTACHMENT_SCANNER=disabled
ALLOW_UNSCANNED_ATTACHMENTS=true
ASSET_SCAN_REQUIRED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
REMOTE_SCANNER_URL=
REMOTE_SCANNER_TOKEN=
REMOTE_SCANNER_TIMEOUT_SECONDS=60
ATTACHMENT_UPLOAD_ENABLED=true
ATTACHMENT_UPLOAD_TTL_HOURS=24
# Local-only signing value. Production rejects this default.
ATTACHMENT_CURSOR_SECRET=chat-reader-local-cursor-v1

BUNDLE_MAX_COMPRESSED_BYTES=536870912
BUNDLE_MAX_EXPANDED_BYTES=2147483648
BUNDLE_MAX_OBJECT_BYTES=268435456
BUNDLE_MAX_ENTRIES=5000
BUNDLE_MAX_OBJECTS=2000
BUNDLE_MAX_COMPRESSION_RATIO=100
BUNDLE_MAX_PATH_DEPTH=4

# Complex Office/archive previews require a separately hosted, sandboxed preview adapter.
COMPLEX_ATTACHMENT_PREVIEW_ENABLED=false
ATTACHMENT_PREVIEW_ORIGIN=
IMPORT_WORKER_POLL_SECONDS=1
IMPORT_STALE_AFTER_SECONDS=300
ENABLE_INTERNAL_DIAGNOSTICS=false
# Technical race-safety window only; it does not change user Export retention.
ARTIFACT_CLEANUP_GRACE_HOURS=24
