diff --git a/lib/depth.js b/lib/depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..d5dec7f28dda916d04c0a797178dcbe7af814371
--- /dev/null
+++ b/lib/depth.js
@@ -0,0 +1,10 @@
+'use strict';
+
+// Bound both parsed nesting and caller-supplied AST traversal before recursion.
+module.exports = depth => {
+  if (depth > 128) {
+    const error = new SyntaxError('Brace pattern exceeds maximum nesting depth (128)');
+    error.code = 'BRACES_MAX_DEPTH';
+    throw error;
+  }
+};
