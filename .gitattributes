# Bundled source bytes must match the installable artifacts on every CI host.
tools/context-skills/**/*.py text eol=lf
tools/context-skills/**/*.md text eol=lf
tools/context-skills/**/*.yaml text eol=lf
tools/context-skills/**/*.json text eol=lf
apps/web/public/skills/*.md text eol=lf
*.zip binary
apps/api/app/services/context_protocol/*.py text eol=lf
# Fingerprint fixtures are byte evidence, including their original newlines.
tools/context-skills/tests/continuation-conformance-fixtures-v1/** -text
# Supplied Markdown references use intentional two-space hard line breaks.
tools/context-skills/**/references/*.md whitespace=-blank-at-eol
patches/*.patch -text whitespace=-blank-at-eol
# Backup shells source their shared reader on Linux and Git/MSYS alike.
deploy/backup.sh text eol=lf
deploy/preflight_release_space.sh text eol=lf
deploy/backup_volume_reader.sh text eol=lf
scripts/ci/image-base-sources.sh text eol=lf
# Dated verification artifacts are byte evidence; never normalize their newlines.
docs/evidence/oom-release-2026-10-19.json -text whitespace=cr-at-eol,-blank-at-eof
docs/evidence/table-tool-*2026-10-2[01]* -text whitespace=cr-at-eol,-blank-at-eof
docs/evidence/table-tool-*2026-10-2[01]/** -text whitespace=cr-at-eol,-blank-at-eof
docs/execution/*2026-10-2[01]-evidence/** -text whitespace=cr-at-eol,-blank-at-eof
# Captured stdout includes terminal padding and assertion whitespace verbatim.
docs/execution/*2026-10-2[01]-evidence/*.txt whitespace=cr-at-eol,-blank-at-eof,-blank-at-eol
# Shared-body table receipts are likewise frozen byte evidence, not source text.
docs/evidence/table-body-shared-2026-10-22.json -text whitespace=cr-at-eol,-blank-at-eof
docs/execution/table-body-shared-2026-10-22-evidence/** -text whitespace=cr-at-eol,-blank-at-eof
docs/execution/table-body-shared-2026-10-22-evidence/*.txt whitespace=cr-at-eol,-blank-at-eof,-blank-at-eol
# Message-copy receipts are immutable synthetic evidence, not source text.
docs/evidence/message-markdown-copy-2026-10-22.json -text whitespace=cr-at-eol,-blank-at-eof
docs/execution/message-markdown-copy-2026-10-22-evidence/** -text whitespace=cr-at-eol,-blank-at-eof
docs/execution/message-markdown-copy-2026-10-22-evidence/*.txt whitespace=cr-at-eol,-blank-at-eof,-blank-at-eol
# Noise-review receipts preserve their captured bytes, including Windows newlines.
docs/execution/ux-audit-noise-matching-2026-10-25-evidence/** -text whitespace=cr-at-eol,-blank-at-eof
# Captured lint stdout retains its original final blank line and newline bytes.
docs/evidence/reading-tools-audit-fixes-2026-11-08/lint-final.log -text whitespace=cr-at-eol,-blank-at-eof
docs/execution/ux-audit-reading-tools-completion-2026-11-08-evidence/lint.log -text whitespace=cr-at-eol,-blank-at-eof
# Preserve the newly archived CI receipts; existing reading receipts are unchanged.
docs/evidence/reliability-2026-11-15/ci-reading-diagnostics-dispatch.json -text whitespace=cr-at-eol,-blank-at-eof
docs/evidence/reliability-2026-11-15/ci-offline-* -text whitespace=cr-at-eol,-blank-at-eof
# New native-scroll receipts are likewise immutable byte evidence.
docs/evidence/reliability-2026-11-15/ci-reader-scroll-* -text whitespace=cr-at-eol,-blank-at-eof
# New worker-budget receipts preserve actual evidence bytes and failed observations.
docs/evidence/reliability-2026-11-15/ci-worker-budget-* -text whitespace=cr-at-eol,-blank-at-eof
# Cold-merge receipts retain failed observations and actual wait clocks verbatim.
docs/evidence/reliability-2026-11-16/ci-cold-merge-* -text whitespace=cr-at-eol,-blank-at-eof
# ZIP release/readiness and isolated scheduling receipts retain their exact bytes.
docs/evidence/reliability-2026-11-16/ci-zip-markdown-* -text whitespace=cr-at-eol,-blank-at-eof
docs/evidence/reliability-2026-11-16/ci-scheduling-* -text whitespace=cr-at-eol,-blank-at-eof
